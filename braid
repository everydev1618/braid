#!/bin/sh
# braid CLI launcher -- resolves its own real location so it works when symlinked onto PATH.
src="$0"
while [ -h "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
exec python3 "$dir/cli.py" "$@"
